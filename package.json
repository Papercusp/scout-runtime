{
  "name": "@papercusp/scout-runtime",
  "version": "0.1.0",
  "description": "Provider-neutral Scout agent loop with application-owned tools and a Vertex Gemini adapter.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vertex": {
      "types": "./src/vertex.ts",
      "import": "./src/vertex.ts",
      "default": "./src/vertex.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^2.17.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
